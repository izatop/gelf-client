{
    "name": "gelf-client",
    "version": "0.1.13",
    "description": "GELF Client for Node.js written in TypeScript.",
    "keywords": [
        "gelf",
        "graylog",
        "logging",
        "nodejs",
        "tcp",
        "transport",
        "typescript",
        "udp"
    ],
    "license": "MIT",
    "author": "izatop@gmail.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/izatop/gelf-client.git"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "scripts": {
        "clean": "rimraf dist tsconfig.tsbuildinfo",
        "build": "bun run clean && tsc",
        "build:watch": "tsc -w",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:typecheck": "tsc -p test/tsconfig.json",
        "examples:typecheck": "tsc -p examples/tsconfig.json",
        "test:package": "bun test/package-consumer.ts",
        "lint": "oxlint .",
        "lint:fix": "oxlint --fix .",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "check": "bun run fmt:check && bun run lint && bun run test:typecheck && bun run examples:typecheck && bun run test && bun run build && bun run test:package",
        "postversion": "git push --tags && git push"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.1",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2"
    },
    "packageManager": "bun@1.3.14"
}
