{
    "name": "gelf-client",
    "version": "0.1.11",
    "description": "GELF Client for Node.js written in TypeScript.",
    "keywords": [
        "gelf",
        "graylog",
        "nodejs",
        "typescript",
        "logging",
        "transport",
        "tcp",
        "udp"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "typings": "dist/index.d.ts",
    "repository": "https://github.com/izatop/gelf-client",
    "author": "izatop@gmail.com",
    "license": "MIT",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rimraf dist",
        "lint": "tslint 'src/**/*.ts'",
        "build": "yarn clean && tsc",
        "build:watch": "tsc -w",
        "postversion": "git push --tags && git push"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "rimraf": "^6.1.3",
        "typescript": "7.0.2",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0"
    },
    "dependencies": {
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.1"
    },
